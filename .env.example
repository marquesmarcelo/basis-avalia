# Copie para .env e preencha os valores antes de subir o ambiente.
# NUNCA comite o .env com valores reais — apenas este .env.example.

# ── Ambiente ────────────────────────────────────────────────────────────
APP_ENV=development
# "production" no deploy — nunca tem default no código (ausência = production)
CORS_ALLOWED_ORIGINS=http://localhost:3000
RUN_TESTS=false
# true roda migrations + seed de teste + testes (ambiente de CI/dev)

# ── Banco de dados ──────────────────────────────────────────────────────
POSTGRES_DB=basisavalia_dev
POSTGRES_USER=basisavalia
POSTGRES_PASSWORD=
POSTGRES_TEST_DB=basisavalia_test
POSTGRES_E2E_DB=basisavalia_e2e
DATABASE_URL=postgres://basisavalia:SENHA@postgres:5432/basisavalia_dev?sslmode=disable
DATABASE_URL_TEST=postgres://basisavalia:SENHA@postgres:5432/basisavalia_test?sslmode=disable
DATABASE_URL_E2E=postgres://basisavalia:SENHA@postgres:5432/basisavalia_e2e?sslmode=disable
# banco próprio para a suíte Playwright (e2e/) — nunca o mesmo de
# DATABASE_URL_TEST: o seed do E2E cria dado de referência estável
# (instituições, usuários fixos) que não é limpo entre execuções, o que
# contamina invariantes globais dos testes de integração Go (ex: "último
# administrador do sistema") se dividirem o mesmo banco.

# ── Cache / sessão ──────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Backend ─────────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=
# preenchido quando o dev-auth implementar autenticação (autenticacao-usuarios)
APP_TIMEZONE=America/Sao_Paulo
APP_VERSION=0.1.0-dev
# lido do arquivo VERSION na raiz; CI/CD injeta o valor real no deploy
# (ver CLAUDE.md, "Versionamento de releases"). Exposto em GET /version.

# ── Seed do Administrador do Sistema (autenticacao-usuarios, 3.13) ───────
SEED_ADMIN_EMAIL=
SEED_ADMIN_SENHA=
# obrigatórias para rodar `go run ./cmd/seed` — sem valor padrão, nunca
# versionadas com valor real. A senha nasce provisória (troca no 1º acesso).
SEED_ADMIN_NOME="Administrador do Sistema"
# opcional — nome só é aplicado na criação (idempotente, nunca sobrescreve
# uma instalação real já seedada). Preencher com o nome real da pessoa
# quando houver um; o default genérico é seguro em produção.

# ── Hash de senha argon2id (autenticacao-usuarios, D-02) ─────────────────
ARGON2_CONCORRENCIA=4
# limite de cálculos de hash concorrentes (semáforo) — não é limite de
# tentativas de login (3.2), apenas proteção do processo contra exaustão
# de memória.

# ── Frontend (autenticacao-usuarios, D-12) ───────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# o frontend chama a API direto do navegador (credentials: "include"),
# nunca via rewrite do Next — ver design.md §11.2

# ── Auditoria — canal 2: syslog remoto (ver CLAUDE.md) ───────────────────
SYSLOG_SERVER=
SYSLOG_PROTOCOL=tcp
SYSLOG_APP_NAME=basis-avalia

# ── Observabilidade ───────────────────────────────────────────────────────
PROMETHEUS_PUSHGATEWAY_URL=
# vazio = Prometheus faz pull via /metrics (padrão em Docker Compose/K8s)

# ── Qualidade (SonarQube no pipeline de CI) ───────────────────────────────
SONAR_TOKEN=

# ── Armazenamento de objetos — MinIO/S3 (plano-metas-curso, doc. .docx;
#    metas-coordenacao, anexo de comprovante) ─────────────────────────────
S3_ENDPOINT=
# dev: http://minio:8000 (interno, ver docker-compose.dev.yml — a imagem
# real é zenko/cloudserver, compatível com S3, não o binário da MinIO;
# ver comentário no serviço `minio` sobre por quê)
# produção: endpoint do MinIO self-hosted ou AWS S3
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# credenciais nunca em arquivo versionado — preencher só no .env local.
# Nenhuma URL de bucket é exposta ao cliente: o download sempre passa por
# rota autenticada do backend (ver specs/_fundacao-metas.md §9)

# ── Envio de e-mail — SMTP (metas-coordenacao: recusa de entrega) ────────
SMTP_HOST=
# dev: mailpit (ver docker-compose.dev.yml) | produção: SMTP corporativo,
# SendGrid, SES
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=
# false em dev (Mailpit não exige TLS) | true em produção
RELE_HABILITADO=true
# desliga o relê de notificações em segundo plano por configuração, sem
# deploy — ver specs/_fundacao-metas.md §7
